# Copy to .env and fill in. server.mjs and scripts/speech.sh read it.

# Required: the brain thread's id (T3 Code → the thread's menu → Copy thread ID).
T3VOICE_THREAD_ID=

# Port of the t3voice server.
# T3VOICE_PORT=5780

# Local speech service (Parakeet + Kokoro on MLX).
# T3VOICE_LOCAL_PORT=5797
# T3VOICE_LOCAL_VOICE=af_heart
# T3VOICE_LOCAL_SPEED=1.0
# T3VOICE_SPEECH_HOME=~/.cache/t3voice

# Where the T3 session, canvas layout and call log live (default: .t3voice/ in this folder).
# T3VOICE_STATE_DIR=

# T3 Code. By default t3voice reads the running server's address from $T3CODE_HOME/userdata.
# T3CODE_HOME=~/.t3
# T3VOICE_T3_ORIGIN=http://127.0.0.1:3773
# T3CODE_CLI_PATH=
