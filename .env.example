# Copy to .env and fill in. server.mjs and scripts/speech.sh read it.

# Required: the brain thread's id (T3 Code → the thread's menu → Copy thread ID).
LALALA_THREAD_ID=

# Port of the lalala server.
# LALALA_PORT=5780

# Local speech service (Parakeet + Kokoro on MLX).
# LALALA_LOCAL_PORT=5797
# LALALA_LOCAL_VOICE=af_heart
# LALALA_LOCAL_SPEED=1.0
# LALALA_SPEECH_HOME=~/.cache/lalala

# Where the T3 session, canvas layout and call log live (default: .lalala/ in this folder).
# LALALA_STATE_DIR=

# T3 Code. By default lalala reads the running server's address from $T3CODE_HOME/userdata.
# T3CODE_HOME=~/.t3
# LALALA_T3_ORIGIN=http://127.0.0.1:3773
# T3CODE_CLI_PATH=
