# Copy to .env and fill in. server.mjs reads it.

# Required: the brain thread's id (T3 Code → the thread's menu → Copy thread ID).
LALALA_THREAD_ID=

# The brain's T3 project folder; your cards live in its cards/ (default: this folder).
# LALALA_WORKSPACE_ROOT=
# LALALA_CARDS_DIR=

# Port of the lalala server.
# LALALA_PORT=5780

# Where the T3 session, canvas layout and call log live (default: .lalala/ in this folder).
# LALALA_STATE_DIR=

# T3 Code. By default lalala reads the running server's address from $T3CODE_HOME/userdata.
# T3CODE_HOME=~/.t3
# LALALA_T3_ORIGIN=http://127.0.0.1:3773
# T3CODE_CLI_PATH=

# Labs: the away digest, a command that gets one summary message as its argument (a Telegram or
# mail script). Off until Settings → Labs → Away digest is on too.
# LALALA_DIGEST_COMMAND=
